# Example environment variables for Provena MCP client and server.
# Copy this file to `.env` in the repository root.
# The MCP server loads `.env` on startup (`server/provena_mcp_server.py`); the client loads it too (`client/mcp_client.py`).
# Values already set in your shell or MCP host take precedence over entries here.

OPENAI_API_KEY=your-openai-api-key-here

# Optional: Set the OpenAI model to use (default: gpt-4o-mini)
# Examples: gpt-4o-mini, gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# Models can be found at https://platform.openai.com/docs/pricing
OPENAI_MODEL=gpt-model-goes-here

# --- Provena (optional; defaults exist for dev stack) ---
# Option A: use the committed example as the instances file (from repo root; adjust path if needed).
PROVENA_CONFIG_FILE=provena_instances.example.json
# Required when the instances file defines more than one instance:
PROVENA_INSTANCE=dev.rrap-is.com
# PROVENA_DOMAIN=dev.rrap-is.com
# PROVENA_REALM=rrap
# PROVENA_TOKENS_FILE=C:\path\to\provena_tokens.json
# PROVENA_OFFLINE_TOKEN=
# Per-instance overrides (example for dev.rrap-is.com):
# PROVENA_DEV_RRAP_IS_COM_KEYCLOAK_DOMAIN=dev.rrap-is.com
# PROVENA_DEV_RRAP_IS_COM_REGISTRY_API=https://registry-api.dev.rrap-is.com
# MCP_OFFLINE_CLIENT_ID=automated-access
# MCP_CLIENT_ID=mcp-client
# Legacy service URLs (used when not set in provena_instances.json):
# DATASTORE_API=https://data-api.dev.rrap-is.com
# REGISTRY_API=https://registry-api.dev.rrap-is.com
# PROV_API=https://prov-api.dev.rrap-is.com
# SEARCH_API=https://search.dev.rrap-is.com
# SEARCH_SERVICE=https://search.dev.rrap-is.com
# HANDLE_SERVICE=https://handle.dev.rrap-is.com
# JOBS_SERVICE=https://job-api.dev.rrap-is.com

# --- MCP HTTP mode (`python server/provena_mcp_server.py --http`) ---
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=5000
# MCP_HTTP_PATH=/mcp
# If the server fell back to legacy SSE, point the sample client at /sse instead:
# PROVENA_MCP_HTTP_URL=http://127.0.0.1:5000/sse

