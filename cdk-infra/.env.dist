# AWS Configuration
AWS_ACCOUNT_ID=123456789012
AWS_REGION=ap-southeast-2
AWS_HOSTED_ZONE_ID=Z1234567890ABC

# Domain Configuration
BASE_DOMAIN=example.com
MCP_SUBDOMAIN=provena-mcp

# CDK Stack Configuration
STACK_NAME=provena-mcp-dev

# Provena MCP runtime (container environment)
PROVENA_INSTANCE=dev.rrap-is.com
# Streamable HTTP path on the container (default / = subdomain root, e.g. https://provena-mcp.example.com)
# MCP_HTTP_PATH=/
# Use /mcp if you prefer https://provena-mcp.example.com/mcp

# Skip Docker build during cdk diff/deploy (use after first image push to ECR)
# MCP_CONTAINER_IMAGE=123456789012.dkr.ecr.ap-southeast-2.amazonaws.com/provena-mcp:latest

# Fargate task size (optional; defaults: 256 CPU units, 1024 MiB)
# MCP_CPU=256
# MCP_MEMORY_MIB=1024

# Secrets Manager (optional ARNs — full secret ARN, including suffix)
# PROVENA_OFFLINE_TOKEN_SECRET_ARN=arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:provena-mcp/offline-token-AbCdEf
# OPENAI_API_KEY_SECRET_ARN=arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:provena-mcp/openai-key-XyZabc
